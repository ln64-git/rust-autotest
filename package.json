{
  "name": "rust-autotest",
  "displayName": "Rust AutoTest",
  "description": "Auto-runs Rust tests on save using VSCode's native test runner.",
  "version": "1.0.0",
  "publisher": "ln64ohio",
  "repository": {
    "type": "git",
    "url": "https://github.com/ln64-git/rust-autotest"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rust-autotest.toggle",
        "title": "Rust AutoTest: Toggle On/Off"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "esbuild": "^0.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  },
  "extensionDependencies": [
    "hbenl.vscode-test-explorer"
  ]
}